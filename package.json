{
  "$schema": "https://json.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "concurrently \"vite\" \"php artisan serve\",",
    "validate-naming": "node ./scripts/validate-naming.cjs",
    "validate-merge": "node ./scripts/validate-merge.cjs",
    "check-env": "node ./scripts/check-environment.cjs",
    "show-config": "node ./scripts/show-config.cjs",
    "branch-info": "node ./scripts/branch-info.cjs",
    "hooks-status": "node ./scripts/hooks-status.cjs",
    "merge-detector": "node ./scripts/merge-detector.cjs",
    "implan-track": "node ./scripts/append-implan.cjs",
    "implan-view": "node -e \"console.log(JSON.stringify(require('../implan.json'), null, 2))\"",
    "php-lint": "node ./scripts/php-linting.cjs",
    "php-format": "vendor/bin/pint",
    "php-md": "vendor/bin/phpmd app,routes text phpmd.xml",
    "php-stan": "vendor/bin/phpstan analyse --memory-limit=1G",
    "php-stan-baseline": "vendor/bin/phpstan analyse --generate-baseline",
    "prepare": "husky install",
    "nodejs-lint": "node ./scripts/nodejs-linting.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "debug-check": "node ./scripts/debug-code-detector.cjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@tailwindcss/forms": "^0.5.2",
    "@tailwindcss/vite": "^4.0.0",
    "alpinejs": "^3.4.2",
    "autoprefixer": "^10.4.2",
    "axios": "^1.8.2",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "laravel-vite-plugin": "^1.2.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.4.31",
    "prettier": "^3.7.3",
    "tailwindcss": "^3.1.0",
    "vite": "^6.2.4"
  },
  "husky": {
    "hooks": {
      "pre-commit": "echo 'Running pre-commit validation...'",
      "prepare-commit-msg": "echo 'Processing commit message...'",
      "commit-msg": "npx --no-install commitlint --edit $1",
      "pre-push": "echo 'Validating push...'"
    }
  }
}
